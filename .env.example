# Injected automatically by Vercel and the Neon Marketplace integration
DATABASE_URL=
NEON_AUTH_BASE_URL=
VITE_NEON_AUTH_URL=
VITE_APP_ORIGIN=https://www.marketagent.shop
VITE_PASSWORD_RESET_URL=https://www.marketagent.shop/reset-password
# Private workspace owner and scheduled-run protection
OWNER_EMAIL=
CRON_SECRET=

# Google OAuth app shared by Gmail, Analytics, and YouTube.
# Enable Gmail API, Google Analytics Admin/Data APIs, YouTube Data API, and YouTube Analytics API.
# Add /api/google-callback, /api/google-analytics-callback, and /api/youtube-callback as authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Keep pending until Google approves the restricted gmail.metadata scope. Set to approved only after approval.
GMAIL_MONITORING_ACCESS_STATUS=pending
CONNECTION_ENCRYPTION_KEY=
APP_BASE_URL=https://www.marketagent.shop

# Social publishing connectors (server-only)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Dedicated Page-only app. Keep status pending until LinkedIn approves Community Management.
# After approval, add its credentials and change status to approved; no rebuild is required.
LINKEDIN_COMMUNITY_CLIENT_ID=
LINKEDIN_COMMUNITY_CLIENT_SECRET=
LINKEDIN_COMMUNITY_ACCESS_STATUS=pending
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Keep false until Reddit grants explicit written commercial Data API approval.
REDDIT_ACCESS_APPROVED=false
# Required by Reddit. Use an accurate app/version and operator username.
REDDIT_USER_AGENT=web:market-agent:1.0.0 (by /u/your_reddit_username)
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
# Optional dedicated OAuth callback origin, useful when Mailchimp requires a custom production domain.
MAILCHIMP_REDIRECT_BASE_URL=https://marketagent.shop
LINKEDIN_VERSION=202609
INSTAGRAM_GRAPH_VERSION=v27.0

# Direct AI provider credentials (server-only)
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Default user-controlled account ceiling for approved creative production (in cents per month)
MEDIA_MONTHLY_BUDGET_CENTS=2500
# Optional absolute safety maximum a user may choose (defaults to $10,000/month)
MEDIA_MAX_MONTHLY_BUDGET_CENTS=1000000

# Optional model overrides
OPENAI_MODEL=gpt-6.1-terra
GOOGLE_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=8787
