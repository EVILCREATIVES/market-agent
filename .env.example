# Injected automatically by Vercel and the Neon Marketplace integration
DATABASE_URL=
NEON_AUTH_BASE_URL=
VITE_NEON_AUTH_URL=
# Private workspace owner and scheduled-run protection
OWNER_EMAIL=
CRON_SECRET=

# Google OAuth app shared by Gmail and Analytics.
# Enable Gmail API, Google Analytics Admin API, and Google Analytics Data API.
# Add /api/google-callback and /api/google-analytics-callback as authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CONNECTION_ENCRYPTION_KEY=
APP_BASE_URL=https://market-agent-lime-gamma.vercel.app

# Social publishing connectors (server-only)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
LINKEDIN_VERSION=202609
INSTAGRAM_GRAPH_VERSION=v24.0

# Direct AI provider credentials (server-only)
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Default user-controlled account ceiling for approved creative production (in cents per month)
MEDIA_MONTHLY_BUDGET_CENTS=2500
# Optional absolute safety maximum a user may choose (defaults to $10,000/month)
MEDIA_MAX_MONTHLY_BUDGET_CENTS=1000000

# Optional model overrides
OPENAI_MODEL=gpt-6.1-terra
GOOGLE_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=8787
