{
  "name": "market-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env.local server/local.mjs",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/google": "^4.0.112",
    "@neon/auth": "^0.8.2",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.6",
    "ai": "^7.0.163",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "jose": "^6.2.15",
    "jszip": "^3.10.2",
    "kiwi-schema": "^0.5.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vercel": "^65.11.0",
    "vite": "^6.0.7"
  }
}
