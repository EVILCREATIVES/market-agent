{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/delivery-cron", "schedule": "*/15 * * * *" },
    { "path": "/api/cron", "schedule": "0 12 * * *" },
    { "path": "/api/memory-cron", "schedule": "0 7 * * *" }
  ],
  "functions": {
    "api/delivery-cron.mjs": { "maxDuration": 60 },
    "api/cron.mjs": { "maxDuration": 300 },
    "api/memory-cron.mjs": { "maxDuration": 300 }
  },
  "rewrites": [{ "source": "/((?!api/|assets/|market-agent-mark\\.svg$|tiktok.*\\.txt$).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
