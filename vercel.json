{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/agent.mjs": { "maxDuration": 300 },
    "api/background-queue.mjs": {
      "maxDuration": 300,
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "market-agent-background", "retryAfterSeconds": 60 }]
    },
    "api/delivery-cron.mjs": { "maxDuration": 60 },
    "api/cron.mjs": { "maxDuration": 300 },
    "api/memory-cron.mjs": { "maxDuration": 300 }
  },
  "rewrites": [{ "source": "/((?!api/|assets/|market-agent-mark\\.svg$|tiktok.*\\.txt$).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
